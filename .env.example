# Server-only names. Put actual values in the ignored .env.local file.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uploads
R2_REGION=auto

# Local development defaults. Configure the deployed HTTPS origin separately.
PORT=3001
APP_ORIGIN=http://localhost:5180
COOKIE_SECURE=false

CAMPUS_DB_SCHEMA=campuslink_prj
CAMPUS_DB_MIGRATE=true
CAMPUS_DB_SEED=false
CAMPUS_STORAGE_PREFIX=campuslink-prj/
