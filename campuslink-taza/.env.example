# Server-only names. Put actual values in the ignored .env.local file.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Google is server-gated and stays disabled until review and explicit activation.
# Google client ID/secret belong in Neon Console, never in VITE_ variables.
GOOGLE_OAUTH_ENABLED=false
ALLOWED_ACADEMIC_EMAIL_DOMAINS=usmba.ac.ma
# Also restricts self-service password recovery, even when Google is disabled.
# Optional exact Google Workspace hosted domains; empty permits verified
# non-Workspace academic Google accounts under the email-domain rule above.
GOOGLE_WORKSPACE_DOMAINS=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uploads
R2_REGION=auto

# Local development defaults. Configure the deployed HTTPS origin separately.
PORT=3001
APP_ORIGIN=http://localhost:5180
COOKIE_SECURE=false

CAMPUS_DB_SCHEMA=campuslink_prj
CAMPUS_DB_MIGRATE=true
CAMPUS_DB_SEED=false
CAMPUS_STORAGE_PREFIX=campuslink-prj/

# Opt-in Web Push, server only. Generate one stable VAPID pair per environment
# with web-push.generateVAPIDKeys(); never rotate the pair on every startup.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://taza-link.vercel.app
# Protects the daily fallback drain. Immediate delivery follows publication.
CRON_SECRET=
