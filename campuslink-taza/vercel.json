{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/backend.js": {
      "includeFiles": "{server/**,shared/**,node_modules/pdfjs-dist/**,node_modules/@napi-rs/canvas*/**,node_modules/*tree-sitter*/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/backend?__path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [{"path":"/api/push/dispatch","schedule":"0 7 * * *"}],
  "headers": [
    {
      "source": "/labs-runtime/runner.js",
      "has": [
        {
          "type": "host",
          "value": "(?<runtimeHost>[a-zA-Z0-9.-]+)"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src https://:runtimeHost/labs-runtime/; worker-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/labs-runtime/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/labs-runtime/python-frame.html",
      "has": [
        {
          "type": "host",
          "value": "(?<runtimeHost>[a-zA-Z0-9.-]+)"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src blob: https://:runtimeHost/labs-runtime/ 'unsafe-eval' 'wasm-unsafe-eval'; connect-src https://:runtimeHost/labs-runtime/; worker-src blob:; frame-src 'none'; form-action 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
